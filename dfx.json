{
  "version": 1,
  "dfx": "0.30.1",
  "canisters": {
    "ouc": {
      "type": "custom",
      "candid": "can.did",
      "wasm": "build/ouc_stubbed.wasm",
      "declarations": {
        "node_compatibility": true
      },
      "metadata": [
        {
          "name": "candid:service"
        }
      ]
    },
    "ouc_dashboard": {
      "type": "assets",
      "source": ["../idris2-ouc-ui/dist"],
      "dependencies": ["ouc"]
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral",
      "replica": {
        "subnet_type": "system"
      }
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  }
}
