{
  "version": 1,
  "dfx": "0.15.0",
  "canisters": {
    "ouc": {
      "type": "custom",
      "candid": "can.did",
      "wasm": "build/ouc_stubbed.wasm",
      "build": ["./scripts/build-canister.sh"],
      "declarations": {
        "node_compatibility": true
      }
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral",
      "replica": {
        "subnet_type": "system"
      }
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  }
}
