// OptimisticUpgraderCanister (OUC) - Candid Interface
// MVP: Returns JSON text for complex types
// Full Candid encoding will be added in Phase 3

// =============================================================================
// Indexer Integration Types (5.3.1)
// =============================================================================
type Tier = variant { Archive; Economy; Standard; RealTime };

type Subscription = record {
    currentTier: Tier;
    expiryDate: nat;
    autoRenew: bool;
};

type Treasury = record {
    ckEthBalance: nat;
    icpBalance: nat;
    cyclesBalance: nat;
};

type AuditorInfo = record {
    auditorId: text;
    principal: text;
    name: text;
    assignedOUs: vec text;
    status: text;
    reputation: nat;
};

service : {
    // ==========================================================================
    // Indexer Query Methods (5.3.1)
    // Called by ICP Indexer for OUC sync
    // ==========================================================================
    getAuditors: () -> (vec AuditorInfo) query;
    getSubscription: () -> (opt Subscription) query;
    getTreasury: () -> (opt Treasury) query;

    // ==========================================================================
    // Original Query Methods
    // ==========================================================================
    getProposal: (nat) -> (text) query;
    getProposalsByChain: (nat) -> (text) query;
    getProposalsByStatus: (text) -> (text) query;
    getAuditor: (principal) -> (text) query;
    getActiveAuditors: () -> (text) query;
    getReviewsForProposal: (nat) -> (text) query;
    getPendingReward: (principal) -> (nat) query;
    getTotalDistributed: (principal) -> (nat) query;
    getTreasuryBalance: () -> (nat) query;
    getOwner: () -> (text) query;
    getVersion: () -> (nat) query;
    getProposalCount: () -> (nat) query;
    getAuditorCount: () -> (nat) query;

    // Update Methods
    // MVP: registerAuditor/suspendAuditor/reactivateAuditor ignore arguments
    // Full Candid arg parsing will be added in Phase 3
    submitProposal: (text) -> (text);
    cancelProposal: (nat) -> (text);
    registerAuditor: () -> (text);
    suspendAuditor: () -> (text);
    reactivateAuditor: () -> (text);
    assignAuditor: (nat, principal) -> (text);
    submitReview: (nat, text) -> (text);
    prepareExecution: (nat) -> (text);
    recordExecution: (nat, text) -> (text);
    distributeReward: (principal, nat) -> (text);
    transferOwnership: (principal) -> (text);

    // HTTP Outcall Test
    testEthBlockNumber: () -> (text);
    testEvmRpc: () -> (text);

    // A-Life Economics
    donate: (text) -> (text);                  // protocol_id -> {balance, tier}
    getProtocolBalance: (text) -> (nat) query; // protocol_id -> balance (cycles)
    getProtocolTier: (text) -> (nat) query;    // protocol_id -> tier (0-3)
    getProtocolCount: () -> (nat) query;       // total registered protocols

    // ==========================================================================
    // Indexer Update Methods (5.3.1)
    // Called from Dashboard via Indexer for tier management
    // ==========================================================================
    setTier: (Tier) -> (opt Subscription);
    setAutoRenew: (bool) -> (opt Subscription);
}
