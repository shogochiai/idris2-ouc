package ouc
version = 0.1.0
authors = "OptimisticUpgrader Team"
brief   = "Optimistic Upgrader Canister for ICP"

depends = idris2-cdk

sourcedir = "src"

modules = Util.StringHex
        , Util.StringCase
        -- OUC Domain Layer
        , OUC.Core
        , OUC.Signatures
        , OUC.MultiSig
        , OUC.Relay
        -- TODO: OUC.Lifecycle and OUC.Obligations need refactoring to use FRMonad API
        -- , OUC.Lifecycle
        -- , OUC.Obligations
        , AuditorPool.Core
        , Rewards.Core
        , Proposals.Core
        -- EVM Communication Layer
        , HttpOutcall.Core
        , HttpOutcall.EvmRpc
        , HttpOutcall.TxSender.Types
        , HttpOutcall.TxSender.Abi
        , HttpOutcall.TxSender.Send
        , HttpOutcall.TxSender
        , ERC7546.Dictionary
        , ERC7546.Upgrade

