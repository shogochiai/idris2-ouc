package ouc
version = 0.1.0
authors = "OptimisticUpgrader Team"
brief   = "Optimistic Upgrader Canister for ICP"

sourcedir = "src"

modules = Util.StringHex
        , Util.StringCase
        , FRC.Core
        -- ICP Base Layer
        , ICP.IC0
        , ICP.API
        , ICP.Candid.Types
        , ICP.StableMemory
        , ICP.Management.HttpOutcall
        , ICP.Management.TECDSA
        -- OUC Domain Layer
        , OUC.Core
        , OUC.Signatures
        , OUC.MultiSig
        , OUC.Relay
        , AuditorPool.Core
        , Rewards.Core
        , Proposals.Core
        -- EVM Communication Layer
        , HttpOutcall.Core
        , HttpOutcall.EvmRpc
        , HttpOutcall.TxSender.Types
        , HttpOutcall.TxSender.Abi
        , HttpOutcall.TxSender.Send
        , HttpOutcall.TxSender
        , ERC7546.Dictionary
        , ERC7546.Upgrade

-- main = Main
-- executable = ouc
