#!/bin/bash
# =============================================================================
# Register OptimisticUpgrader as ERC-7546 Upgrader
# Generated by LazyEvmLifecycle
# =============================================================================
#
# This script registers an OptimisticUpgrader (OU) as the authorized upgrader
# for an ERC-7546 Proxy contract.
#
# Variables (must be set before sourcing):
#   CHAIN_ID       - Target EVM chain ID
#   PROXY_ADDRESS  - ERC-7546 Proxy contract address
#   OU_ADDRESS     - OptimisticUpgrader contract to register
#   RPC_URL        - EVM RPC endpoint
#   PRIVATE_KEY    - Owner private key (or use --ledger)
#   OUC_SIGNATURE  - OUC vetKey signature authorizing this registration
#
# Evidence output:
#   - Transaction hash
#   - Registration event logs
#   - Current upgrader address after registration
# =============================================================================

set -euo pipefail

# Template variables (replaced by LazyEvmLifecycle)
CHAIN_ID="${CHAIN_ID:-{{CHAIN_ID}}}"
PROXY_ADDRESS="${PROXY_ADDRESS:-{{PROXY_ADDRESS}}}"
OU_ADDRESS="${OU_ADDRESS:-{{OU_ADDRESS}}}"
RPC_URL="${RPC_URL:-{{RPC_URL}}}"

# Validate required variables
if [[ -z "${PRIVATE_KEY:-}" && -z "${LEDGER:-}" ]]; then
  echo "ERROR: Either PRIVATE_KEY or LEDGER must be set" >&2
  exit 1
fi

echo "=== Register ERC-7546 Upgrader ==="
echo "Chain ID:      $CHAIN_ID"
echo "Proxy Address: $PROXY_ADDRESS"
echo "OU Address:    $OU_ADDRESS"
echo ""

# Check current upgrader
echo "Checking current upgrader..."
CURRENT_UPGRADER=$(cast call --rpc-url "$RPC_URL" "$PROXY_ADDRESS" "upgrader()(address)" 2>/dev/null || echo "")

if [[ -n "$CURRENT_UPGRADER" && "$CURRENT_UPGRADER" != "0x0000000000000000000000000000000000000000" ]]; then
  CURRENT_UPGRADER_LOWER=$(echo "$CURRENT_UPGRADER" | tr '[:upper:]' '[:lower:]')
  OU_ADDRESS_LOWER=$(echo "$OU_ADDRESS" | tr '[:upper:]' '[:lower:]')

  if [[ "$CURRENT_UPGRADER_LOWER" == "$OU_ADDRESS_LOWER" ]]; then
    echo "OU already registered as upgrader"

    cat << EOF > evidence_register_upgrader.json
{
  "operation": "register_erc7546_upgrader",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "ouAddress": "$OU_ADDRESS",
  "result": "AlreadyRegistered",
  "currentUpgrader": "$CURRENT_UPGRADER",
  "status": "idempotent_success"
}
EOF
    echo "Evidence written to: evidence_register_upgrader.json"
    echo "=== Already Registered ==="
    exit 0
  else
    echo "WARNING: Different upgrader registered: $CURRENT_UPGRADER"
    echo "Proceeding to update upgrader..."
  fi
fi

# Build cast command
CAST_CMD="cast send"
CAST_CMD+=" --rpc-url $RPC_URL"
CAST_CMD+=" --chain $CHAIN_ID"

if [[ -n "${PRIVATE_KEY:-}" ]]; then
  CAST_CMD+=" --private-key $PRIVATE_KEY"
elif [[ -n "${LEDGER:-}" ]]; then
  CAST_CMD+=" --ledger"
fi

# registerUpgrader with OUC signature proof
CAST_CMD+=" $PROXY_ADDRESS"
CAST_CMD+=" 'registerUpgrader(address,bytes)' '$OU_ADDRESS' '${OUC_SIGNATURE:-0x}'"

echo "Executing: $CAST_CMD"
echo ""

# Execute
TX_OUTPUT=$(eval "$CAST_CMD" 2>&1) || {
  echo "ERROR: registerUpgrader transaction failed" >&2
  echo "$TX_OUTPUT" >&2

  cat << EOF > evidence_register_upgrader.json
{
  "operation": "register_erc7546_upgrader",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "ouAddress": "$OU_ADDRESS",
  "result": "Failed",
  "error": "$(echo "$TX_OUTPUT" | tr '\n' ' ' | sed 's/"/\\"/g')",
  "status": "transaction_failed"
}
EOF
  exit 1
}

# Extract transaction hash
TX_HASH=$(echo "$TX_OUTPUT" | grep -oE '0x[a-fA-F0-9]{64}' | head -1)

echo "Transaction submitted: $TX_HASH"
echo "Waiting for confirmation..."

# Wait for receipt
RECEIPT=$(cast receipt --rpc-url "$RPC_URL" "$TX_HASH" --json)
GAS_USED=$(echo "$RECEIPT" | jq -r '.gasUsed')
STATUS=$(echo "$RECEIPT" | jq -r '.status')

if [[ "$STATUS" != "0x1" && "$STATUS" != "1" ]]; then
  echo "ERROR: Transaction reverted" >&2

  cat << EOF > evidence_register_upgrader.json
{
  "operation": "register_erc7546_upgrader",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "ouAddress": "$OU_ADDRESS",
  "result": "Reverted",
  "txHash": "$TX_HASH",
  "gasUsed": "$GAS_USED",
  "status": "reverted"
}
EOF
  exit 1
fi

# Verify registration
echo "Verifying registration..."
NEW_UPGRADER=$(cast call --rpc-url "$RPC_URL" "$PROXY_ADDRESS" "upgrader()(address)")

cat << EOF > evidence_register_upgrader.json
{
  "operation": "register_erc7546_upgrader",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "ouAddress": "$OU_ADDRESS",
  "result": "Registered",
  "txHash": "$TX_HASH",
  "gasUsed": "$GAS_USED",
  "verifiedUpgrader": "$NEW_UPGRADER",
  "status": "success"
}
EOF

echo ""
echo "Upgrader registered successfully!"
echo "Verified upgrader: $NEW_UPGRADER"
echo "Evidence written to: evidence_register_upgrader.json"
echo ""
echo "=== Registration Complete ==="
