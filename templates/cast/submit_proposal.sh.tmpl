#!/bin/bash
# =============================================================================
# Submit Upgrade Proposal to OUC
# Generated by LazyEvmLifecycle
# =============================================================================
#
# This script submits an upgrade proposal to the OptimisticUpgraderCanister (OUC).
# It can be called after lazy evm-lifecycle ask detects an upgrade recommendation.
#
# The proposal establishes the equivalence:
#   "upgrade推奨 (LazyEvmLifecycle)" ≡ "proposal到達 (OUC)"
#
# Variables (must be set before sourcing):
#   OUC_CANISTER_ID - OUC canister principal
#   CHAIN_ID        - Target EVM chain ID
#   TARGET          - ERC-7546 Proxy contract address
#   NEW_IMPL        - New implementation address
#   OU_ADDRESS      - OptimisticUpgrader address
#   RATIONALE       - Human-readable upgrade rationale
#   CODE_HASH       - Keccak256 hash of new implementation
#   DFX_NETWORK     - IC network (local, ic, etc.)
#   FEE             - Proposal submission fee
#
# Evidence output:
#   - Proposal ID assigned by OUC
#   - Receipt timestamp
#   - OUC acknowledgment
# =============================================================================

set -euo pipefail

# Template variables (replaced by LazyEvmLifecycle)
OUC_CANISTER_ID="${OUC_CANISTER_ID:-{{OUC_CANISTER_ID}}}"
CHAIN_ID="${CHAIN_ID:-{{CHAIN_ID}}}"
TARGET="${TARGET:-{{TARGET}}}"
NEW_IMPL="${NEW_IMPL:-{{NEW_IMPL}}}"
OU_ADDRESS="${OU_ADDRESS:-{{OU_ADDRESS}}}"
RATIONALE="${RATIONALE:-{{RATIONALE}}}"
CODE_HASH="${CODE_HASH:-{{CODE_HASH}}}"
DFX_NETWORK="${DFX_NETWORK:-local}"
FEE="${FEE:-{{FEE}}}"

# Source evidence from LazyEvmLifecycle ask output
SOURCE_EVIDENCE="${SOURCE_EVIDENCE:-}"

echo "=== Submit Upgrade Proposal to OUC ==="
echo "OUC Canister:  $OUC_CANISTER_ID"
echo "Chain ID:      $CHAIN_ID"
echo "Target:        $TARGET"
echo "New Impl:      $NEW_IMPL"
echo "OU:            $OU_ADDRESS"
echo "Network:       $DFX_NETWORK"
echo ""

# Check dfx is available
if ! command -v dfx &> /dev/null; then
  echo "ERROR: dfx not found in PATH" >&2
  exit 1
fi

# Build Candid argument
# Note: This matches the OUC.receiveFromLifecycle interface
CANDID_ARG="(
  record {
    chainId = $CHAIN_ID : nat;
    target = \"$TARGET\";
    newImpl = \"$NEW_IMPL\";
    ou = \"$OU_ADDRESS\";
    rationale = \"$RATIONALE\";
    codeHash = \"$CODE_HASH\";
    sourceEvidence = \"${SOURCE_EVIDENCE:-LazyEvmLifecycle}\";
    fee = $FEE : nat;
  }
)"

echo "Submitting proposal..."
echo ""

# Call OUC canister
CALL_OUTPUT=$(dfx canister call "$OUC_CANISTER_ID" submitProposal "$CANDID_ARG" --network "$DFX_NETWORK" 2>&1) || {
  echo "ERROR: Proposal submission failed" >&2
  echo "$CALL_OUTPUT" >&2

  cat << EOF > evidence_submit_proposal.json
{
  "operation": "submit_proposal",
  "timestamp": $(date +%s),
  "oucCanisterId": "$OUC_CANISTER_ID",
  "chainId": $CHAIN_ID,
  "target": "$TARGET",
  "newImpl": "$NEW_IMPL",
  "result": "Failed",
  "error": "$(echo "$CALL_OUTPUT" | tr '\n' ' ' | sed 's/"/\\"/g')",
  "status": "call_failed"
}
EOF
  exit 1
}

echo "Response: $CALL_OUTPUT"
echo ""

# Parse response to extract proposal ID
# Expected format: (variant { Ok = record { proposalId = 123 : nat; ... } })
PROPOSAL_ID=$(echo "$CALL_OUTPUT" | grep -oE 'proposalId = [0-9]+' | grep -oE '[0-9]+' || echo "")

if [[ -z "$PROPOSAL_ID" ]]; then
  # Check for error variant
  if echo "$CALL_OUTPUT" | grep -q "Err"; then
    echo "ERROR: OUC returned error" >&2

    cat << EOF > evidence_submit_proposal.json
{
  "operation": "submit_proposal",
  "timestamp": $(date +%s),
  "oucCanisterId": "$OUC_CANISTER_ID",
  "chainId": $CHAIN_ID,
  "target": "$TARGET",
  "newImpl": "$NEW_IMPL",
  "result": "Rejected",
  "response": "$(echo "$CALL_OUTPUT" | tr '\n' ' ' | sed 's/"/\\"/g')",
  "status": "ouc_rejected"
}
EOF
    exit 1
  fi
fi

echo "Proposal submitted successfully!"
echo "Proposal ID: ${PROPOSAL_ID:-unknown}"

# Generate receipt evidence
cat << EOF > evidence_submit_proposal.json
{
  "operation": "submit_proposal",
  "timestamp": $(date +%s),
  "oucCanisterId": "$OUC_CANISTER_ID",
  "chainId": $CHAIN_ID,
  "target": "$TARGET",
  "newImpl": "$NEW_IMPL",
  "ou": "$OU_ADDRESS",
  "codeHash": "$CODE_HASH",
  "proposalId": ${PROPOSAL_ID:-null},
  "result": "Accepted",
  "response": "$(echo "$CALL_OUTPUT" | tr '\n' ' ' | sed 's/"/\\"/g')",
  "sourceEvidence": "${SOURCE_EVIDENCE:-LazyEvmLifecycle}",
  "status": "success"
}
EOF

echo ""
echo "Evidence written to: evidence_submit_proposal.json"
echo ""
echo "=== Proposal Submission Complete ==="
echo ""
echo "Next steps:"
echo "1. Monitor proposal status: dfx canister call $OUC_CANISTER_ID getProposal '($PROPOSAL_ID)' --network $DFX_NETWORK"
echo "2. Wait for auditor review"
echo "3. If approved, execute upgrade via OU"
