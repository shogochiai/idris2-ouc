#!/bin/bash
# =============================================================================
# Set Owner (onlyOnce) for ERC-7546 Proxy
# Generated by LazyEvmLifecycle
# =============================================================================
#
# This script sets the owner of an ERC-7546 Proxy to the OUC.
# This is a one-time operation - subsequent calls will fail or be idempotent.
#
# The operation is designed to be:
# - Idempotent: Already set returns AlreadySet (not failure)
# - Observable: Both success and AlreadySet produce evidence
# - Auditable: OUC signature required as proof
#
# Variables (must be set before sourcing):
#   CHAIN_ID       - Target EVM chain ID
#   PROXY_ADDRESS  - ERC-7546 Proxy contract address
#   OWNER_ADDRESS  - Address to set as owner (OUC's EVM representation)
#   RPC_URL        - EVM RPC endpoint
#   PRIVATE_KEY    - Deployer private key (or use --ledger)
#   OUC_SIGNATURE  - OUC vetKey signature authorizing this operation
#
# Evidence output:
#   - Transaction hash (if new set)
#   - Current owner (if already set)
#   - Operation result: OwnerSet | AlreadySet | Blocked
# =============================================================================

set -euo pipefail

# Template variables (replaced by LazyEvmLifecycle)
CHAIN_ID="${CHAIN_ID:-{{CHAIN_ID}}}"
PROXY_ADDRESS="${PROXY_ADDRESS:-{{PROXY_ADDRESS}}}"
OWNER_ADDRESS="${OWNER_ADDRESS:-{{OWNER_ADDRESS}}}"
RPC_URL="${RPC_URL:-{{RPC_URL}}}"

# Validate required variables
if [[ -z "${PRIVATE_KEY:-}" && -z "${LEDGER:-}" ]]; then
  echo "ERROR: Either PRIVATE_KEY or LEDGER must be set" >&2
  exit 1
fi

if [[ -z "${OUC_SIGNATURE:-}" ]]; then
  echo "WARNING: OUC_SIGNATURE not set - operation may fail authorization" >&2
fi

echo "=== Set Owner (onlyOnce) ==="
echo "Chain ID:      $CHAIN_ID"
echo "Proxy Address: $PROXY_ADDRESS"
echo "New Owner:     $OWNER_ADDRESS"
echo ""

# First, check current owner
echo "Checking current owner..."
CURRENT_OWNER=$(cast call --rpc-url "$RPC_URL" "$PROXY_ADDRESS" "owner()(address)" 2>/dev/null || echo "")

if [[ -n "$CURRENT_OWNER" && "$CURRENT_OWNER" != "0x0000000000000000000000000000000000000000" ]]; then
  # Owner already set
  CURRENT_OWNER_LOWER=$(echo "$CURRENT_OWNER" | tr '[:upper:]' '[:lower:]')
  OWNER_ADDRESS_LOWER=$(echo "$OWNER_ADDRESS" | tr '[:upper:]' '[:lower:]')

  if [[ "$CURRENT_OWNER_LOWER" == "$OWNER_ADDRESS_LOWER" ]]; then
    echo "Owner already set to desired address: $CURRENT_OWNER"

    # Output AlreadySet evidence
    cat << EOF > evidence_set_owner.json
{
  "operation": "set_owner_only_once",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "result": "AlreadySet",
  "currentOwner": "$CURRENT_OWNER",
  "desiredOwner": "$OWNER_ADDRESS",
  "status": "idempotent_success"
}
EOF
    echo ""
    echo "Evidence written to: evidence_set_owner.json"
    echo "=== Already Set (Idempotent) ==="
    exit 0
  else
    echo "ERROR: Owner already set to different address: $CURRENT_OWNER" >&2

    # Output Blocked evidence
    cat << EOF > evidence_set_owner.json
{
  "operation": "set_owner_only_once",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "result": "Blocked",
  "currentOwner": "$CURRENT_OWNER",
  "desiredOwner": "$OWNER_ADDRESS",
  "status": "blocked_different_owner"
}
EOF
    echo ""
    echo "Evidence written to: evidence_set_owner.json"
    exit 1
  fi
fi

echo "Owner not yet set, proceeding with setOwner..."

# Build cast command
CAST_CMD="cast send"
CAST_CMD+=" --rpc-url $RPC_URL"
CAST_CMD+=" --chain $CHAIN_ID"

if [[ -n "${PRIVATE_KEY:-}" ]]; then
  CAST_CMD+=" --private-key $PRIVATE_KEY"
elif [[ -n "${LEDGER:-}" ]]; then
  CAST_CMD+=" --ledger"
fi

# setOwner with signature proof
CAST_CMD+=" $PROXY_ADDRESS"
CAST_CMD+=" 'setOwner(address,bytes)' '$OWNER_ADDRESS' '${OUC_SIGNATURE:-0x}'"

echo "Executing: $CAST_CMD"
echo ""

# Execute and capture output
TX_OUTPUT=$(eval "$CAST_CMD" 2>&1) || {
  echo "ERROR: setOwner transaction failed" >&2
  echo "$TX_OUTPUT" >&2

  # Output Blocked evidence
  cat << EOF > evidence_set_owner.json
{
  "operation": "set_owner_only_once",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "result": "Blocked",
  "error": "$(echo "$TX_OUTPUT" | tr '\n' ' ' | sed 's/"/\\"/g')",
  "desiredOwner": "$OWNER_ADDRESS",
  "status": "transaction_failed"
}
EOF
  exit 1
}

# Extract transaction hash
TX_HASH=$(echo "$TX_OUTPUT" | grep -oE '0x[a-fA-F0-9]{64}' | head -1)

if [[ -z "$TX_HASH" ]]; then
  echo "ERROR: Could not extract transaction hash" >&2
  exit 1
fi

echo "Transaction submitted: $TX_HASH"
echo ""
echo "Waiting for confirmation..."

# Wait for receipt
RECEIPT=$(cast receipt --rpc-url "$RPC_URL" "$TX_HASH" --json)
GAS_USED=$(echo "$RECEIPT" | jq -r '.gasUsed')
STATUS=$(echo "$RECEIPT" | jq -r '.status')

if [[ "$STATUS" != "0x1" && "$STATUS" != "1" ]]; then
  echo "ERROR: Transaction reverted" >&2

  cat << EOF > evidence_set_owner.json
{
  "operation": "set_owner_only_once",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "result": "Blocked",
  "txHash": "$TX_HASH",
  "gasUsed": "$GAS_USED",
  "desiredOwner": "$OWNER_ADDRESS",
  "status": "reverted"
}
EOF
  exit 1
fi

# Success - output OwnerSet evidence
cat << EOF > evidence_set_owner.json
{
  "operation": "set_owner_only_once",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "proxyAddress": "$PROXY_ADDRESS",
  "result": "OwnerSet",
  "txHash": "$TX_HASH",
  "gasUsed": "$GAS_USED",
  "newOwner": "$OWNER_ADDRESS",
  "status": "success"
}
EOF

echo ""
echo "Owner successfully set!"
echo "Evidence written to: evidence_set_owner.json"
echo ""
echo "=== Owner Set Complete ==="
