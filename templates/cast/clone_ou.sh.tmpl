#!/bin/bash
# =============================================================================
# Clone OptimisticUpgrader (OU) from Factory
# Generated by LazyEvmLifecycle
# =============================================================================
#
# This script clones a new OptimisticUpgrader instance from the OUF.
# Fee payment is required and included in the transaction value.
#
# Variables (must be set before sourcing):
#   CHAIN_ID       - Target EVM chain ID
#   OUF_ADDRESS    - OptimisticUpgraderFactory contract address
#   RPC_URL        - EVM RPC endpoint
#   PRIVATE_KEY    - Deployer private key (or use --ledger)
#   CLONE_FEE      - Fee to pay for cloning (in wei)
#
# Evidence output:
#   - Transaction hash
#   - New OU address (from event logs)
#   - Gas used
# =============================================================================

set -euo pipefail

# Template variables (replaced by LazyEvmLifecycle)
CHAIN_ID="${CHAIN_ID:-{{CHAIN_ID}}}"
OUF_ADDRESS="${OUF_ADDRESS:-{{OUF_ADDRESS}}}"
RPC_URL="${RPC_URL:-{{RPC_URL}}}"
CLONE_FEE="${CLONE_FEE:-{{CLONE_FEE}}}"

# Validate required variables
if [[ -z "$PRIVATE_KEY" && -z "$LEDGER" ]]; then
  echo "ERROR: Either PRIVATE_KEY or LEDGER must be set" >&2
  exit 1
fi

# Clone parameters (optional customization)
CLONE_PARAMS="${CLONE_PARAMS:-}"

echo "=== Clone OptimisticUpgrader ==="
echo "Chain ID:    $CHAIN_ID"
echo "OUF Address: $OUF_ADDRESS"
echo "Clone Fee:   $CLONE_FEE wei"
echo ""

# Build cast command
CAST_CMD="cast send"
CAST_CMD+=" --rpc-url $RPC_URL"
CAST_CMD+=" --chain $CHAIN_ID"

if [[ -n "${PRIVATE_KEY:-}" ]]; then
  CAST_CMD+=" --private-key $PRIVATE_KEY"
elif [[ -n "${LEDGER:-}" ]]; then
  CAST_CMD+=" --ledger"
fi

CAST_CMD+=" --value $CLONE_FEE"
CAST_CMD+=" $OUF_ADDRESS"
CAST_CMD+=" 'clone(bytes)' '$CLONE_PARAMS'"

echo "Executing: $CAST_CMD"
echo ""

# Execute and capture output
TX_OUTPUT=$(eval "$CAST_CMD" 2>&1) || {
  echo "ERROR: Clone transaction failed" >&2
  echo "$TX_OUTPUT" >&2
  exit 1
}

# Extract transaction hash
TX_HASH=$(echo "$TX_OUTPUT" | grep -oE '0x[a-fA-F0-9]{64}' | head -1)

if [[ -z "$TX_HASH" ]]; then
  echo "ERROR: Could not extract transaction hash" >&2
  echo "$TX_OUTPUT" >&2
  exit 1
fi

echo "Transaction submitted: $TX_HASH"
echo ""
echo "Waiting for confirmation..."

# Wait for receipt
RECEIPT=$(cast receipt --rpc-url "$RPC_URL" "$TX_HASH" --json)

# Extract OU address from Cloned event
# Event signature: Cloned(address indexed ou, address indexed owner, bytes params)
OU_ADDRESS=$(echo "$RECEIPT" | jq -r '.logs[] | select(.topics[0] | startswith("0x")) | .topics[1]' | head -1)

if [[ -n "$OU_ADDRESS" ]]; then
  # Convert topic to address (remove leading zeros)
  OU_ADDRESS="0x${OU_ADDRESS:26}"
  echo "New OU Address: $OU_ADDRESS"
fi

# Extract gas used
GAS_USED=$(echo "$RECEIPT" | jq -r '.gasUsed')

# Output evidence JSON
cat << EOF > evidence_clone_ou.json
{
  "operation": "clone_ou",
  "timestamp": $(date +%s),
  "chainId": $CHAIN_ID,
  "oufAddress": "$OUF_ADDRESS",
  "txHash": "$TX_HASH",
  "ouAddress": "${OU_ADDRESS:-unknown}",
  "gasUsed": "$GAS_USED",
  "cloneFee": "$CLONE_FEE",
  "status": "success"
}
EOF

echo ""
echo "Evidence written to: evidence_clone_ou.json"
echo ""
echo "=== Clone Complete ==="
